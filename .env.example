# OpenAI (used by agents/blast-scan/report_generator.py and
# agents/splint/fix_generator.py -- gpt-4o-mini only, keep costs at $0-ish)
OPENAI_API_KEY=

# DataHub (local: `datahub docker quickstart`, UI at http://localhost:9002)
# Note: GraphQL calls go to DataHub's GMS port, not the 9002 web UI --
# if GMS is exposed separately in your setup, point DATAHUB_SERVER there.
DATAHUB_SERVER=http://localhost:9002
DATAHUB_TOKEN=

# GitHub (provided automatically as GITHUB_TOKEN inside Actions; set manually for local runs)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_PR_NUMBER=

# Set to 1 to use the mock LLM summarizer/fix-generator instead of calling OpenAI (saves budget during dev)
BLAST_MOCK_LLM=1

# Set to 1 to use local lineage/dataset fixtures instead of a live DataHub instance
BLAST_MOCK_DATAHUB=1

# Which path reads DataHub lineage: auto (try MCP Server, fall back to
# GraphQL), mcp (MCP only, errors if unavailable -- useful to confirm the
# MCP path actually works), graphql (skip MCP entirely).
BLAST_DATAHUB_MODE=auto

# Only used if BLAST_DATAHUB_MODE tries the MCP path: how to spawn
# DataHub's MCP server. See agents/_common/mcp_lineage_client.py.
DATAHUB_MCP_COMMAND=uvx
DATAHUB_MCP_ARGS=mcp-server-datahub

# How to build the changed dataset's URN from its model name, with a
# {model} placeholder. Default assumes dbt-sourced ingestion. Instances
# ingesting via the postgres source instead (no dbt run required -- see
# commerce-warehouse's README) need a different platform + a
# database-qualified name, e.g.:
# BLAST_DATASET_URN_TEMPLATE=urn:li:dataset:(urn:li:dataPlatform:postgres,commerce_warehouse.public.{model},PROD)
